# Supabase menjadi satu-satunya sumber auth, konten, dan penyimpanan foto.
# Ambil kedua nilai dari dashboard Supabase > Project Settings > API.
#
# JANGAN pernah menaruh service_role key di sini. Kunci itu melewati seluruh
# RLS, dan apa pun berawalan NEXT_PUBLIC_ ikut terbundel ke JavaScript yang
# dikirim ke setiap pengunjung.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
