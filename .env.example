# Supabase. Isi keduanya untuk mengaktifkan auth, database, dan storage.
# Ambil dari dashboard Supabase > Project Settings > API.
# Selama kosong, aplikasi berjalan dalam mode lokal: konten di localStorage dan
# login memakai kredensial di bawah.
# JANGAN pernah menaruh service_role key di sini - kunci itu melewati seluruh RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nomor WhatsApp tujuan pemesanan (format internasional, tanpa + atau spasi)
NEXT_PUBLIC_WHATSAPP_NUMBER=628120000000

# Nama brand yang tampil di seluruh halaman
NEXT_PUBLIC_BRAND_NAME=[NAMA BRAND]

# Kredensial admin untuk mode lokal (development saja), dipakai hanya selama
# NEXT_PUBLIC_SUPABASE_URL masih kosong.
# Nilai NEXT_PUBLIC_* terbundel ke browser dan bisa dibaca siapa pun.
# Kosongkan di produksi dan pakai Supabase Auth.
NEXT_PUBLIC_ADMIN_EMAIL=admin@catering.test
NEXT_PUBLIC_ADMIN_PASSWORD=admin123
